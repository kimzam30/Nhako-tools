{
  "name": "nhako-tools",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-sw.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "vendor": "node scripts/vendor.mjs",
    "prebuild": "node scripts/vendor.mjs",
    "predev": "node scripts/vendor.mjs",
    "icons": "node scripts/icons.mjs",
    "og": "node scripts/og-images.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:e2e:mobile": "playwright test --project=android --project=ios --project=ios-landscape --project=ipados --project=ipados-landscape"
  },
  "dependencies": {
    "@astrojs/preact": "^4.1.3",
    "@astrojs/sitemap": "^3.2.1",
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource/dancing-script": "^5.3.0",
    "@matbee/libreoffice-converter": "^2.7.2",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/msa": "^1.0.0",
    "@xenova/transformers": "^2.17.2",
    "astro": "^5.2.0",
    "comlink": "^4.4.2",
    "diff": "^7.0.0",
    "jszip": "^3.10.1",
    "libheif-js": "^1.23.2",
    "onnxruntime-web": "1.14.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "preact": "^10.29.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.50.0",
    "@types/diff": "^6.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "astro-eslint-parser": "^1.4.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.5"
  }
}
