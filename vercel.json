{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/tool/merge-pdf",           "destination": "/pdf/merge",            "permanent": true },
    { "source": "/tool/split-pdf",           "destination": "/pdf/split",            "permanent": true },
    { "source": "/tool/compress-pdf",        "destination": "/pdf/compress",         "permanent": true },
    { "source": "/tool/convert-pdf",         "destination": "/pdf/to-image",         "permanent": true },
    { "source": "/tool/edit-pdf",            "destination": "/pdf/rotate",           "permanent": true },
    { "source": "/tool/video-size-compress", "destination": "/media/compress-video", "permanent": true },
    { "source": "/tool/extract-assets",      "destination": "/media/extract-audio",  "permanent": true },
    { "source": "/tool/audio-to-text",       "destination": "/media/transcribe",     "permanent": true },
    { "source": "/tool/json-formatter",      "destination": "/dev/json",             "permanent": true },
    { "source": "/tool/jwt-decoder",         "destination": "/dev/jwt",              "permanent": true },
    { "source": "/tool/base64-converter",    "destination": "/dev/base64",           "permanent": true },
    { "source": "/tool/word-counter",        "destination": "/dev/word-count",       "permanent": true },
    { "source": "/tool/css-generator",       "destination": "/dev/css-shadow",       "permanent": true }
  ]
}
