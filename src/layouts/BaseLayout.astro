---
import '../styles/tokens.css';
import Nav from '../components/astro/Nav.astro';
import Footer from '../components/astro/Footer.astro';
import ButterflySky from '../components/astro/ButterflySky.astro';
import TabBar from '../components/astro/TabBar.astro';
import InstallPrompt from '../components/astro/InstallPrompt.astro';
import { LANG, LOCALES, localePath, ui, type Locale } from '../i18n';
import { FAVORITES_EVENT, FAVORITES_KEY } from '../lib/favorites';
import { CATEGORIES } from '../tools/types';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /**
   * The page's path WITHOUT a locale prefix, e.g. "/pdf/merge". The canonical
   * URL, the hreflang alternates and the language switch are all built from
   * it, so the English and Malay versions always point at each other.
   */
  path: string;
  /** False for pages with no translated twin (the 404). */
  alternates?: boolean;
  keywords?: string[];
  jsonLd?: Record<string, unknown>;
  /** Category slug, used to pick the social preview image. */
  category?: string;
  /** Full <title> override. Defaults to "<title> | Nhako Tools". */
  documentTitle?: string;
  /** Keep a page out of search results (and out of the sitemap, see astro.config.mjs). */
  noindex?: boolean;
}

const { title, description, path, keywords, jsonLd, category, documentTitle, noindex = false, locale = 'en', alternates = true } = Astro.props;
const t = ui(locale);
const site = Astro.site ?? new URL('https://tools.nhako.com');
const canonical = new URL(localePath(locale, path), site);

// The <title> is also the search result headline, and "Merge PDF" alone is
// word for word what every competitor ranks with. The page name still leads,
// so a narrow tab shows the part people scan for; the brand trails.
const tabTitle = documentTitle ?? (title === 'Nhako Tools' ? title : `${title} | Nhako Tools`);

// Social cards have no such context, so they keep the brand.
const socialTitle = title === 'Nhako Tools' ? title : `${title} | Nhako Tools`;
const ogImage = new URL(`/og/${category ?? 'default'}.png`, site);

// Pages the header and tab bar lead to, in both languages: the ones worth
// prerendering on hover (see the speculation rules in <head>).
const SECTION_PATHS = LOCALES.flatMap((l) =>
  ['/', ...CATEGORIES.map((c) => `/${c}`), '/malaysia', '/favourites', '/feedback', '/about', '/privacy'].map((p) => localePath(l, p)),
);

---

<!doctype html>
<html lang={LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover hands the notch, the rounded corners and the home
        indicator's strip to the page, which is what lets the tab bar sit on
        the bottom edge like a native one. app.css keeps content out of them. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tabTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonical.href} />
    {alternates && LOCALES.map((l) => (
      <link rel="alternate" hreflang={LANG[l]} href={new URL(localePath(l, path), site).href} />
    ))}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(path, site).href} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Nhako Tools" />
    <meta property="og:locale" content={locale === 'ms' ? 'ms_MY' : 'en_MY'} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {/* Added to a home screen, iOS reads these rather than the manifest. The
        status bar stays opaque ("default") so it never draws white text over
        the light theme. The short title fits under an icon without "...". */}
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Nhako" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {/*
      Vercel Web Analytics: cookieless, no personal data, and served from this
      same origin (/_vercel/insights), so it needs no CORS or COEP exception.
      Production builds only; the path does not exist in dev or local preview.
      It records page views, never files or tool input. See /privacy.
    */}
    {import.meta.env.PROD && (
      <script is:inline>
        window.va = window.va || function (...args) { (window.vaq = window.vaq || []).push(args); };
        // A prerendered page (see the speculation rules below) is one somebody
        // hovered, not one they opened, so the view only counts once it is
        // actually shown.
        (() => {
          const load = () => {
            const s = document.createElement('script');
            s.src = '/_vercel/insights/script.js';
            s.defer = true;
            document.head.append(s);
          };
          if (document.prerendering) document.addEventListener('prerenderingchange', load, { once: true });
          else load();
        })();
      </script>
    )}

    {/*
      Instant section switches with no JavaScript bundle: Chrome and Edge
      prerender a section page while the pointer rests on its link (or from
      the moment a finger lands on a tab), so the page is already painted
      when the click arrives. Only the section pages: a tool page starts
      engines and workers, which is not worth doing for a hover. Everything
      else gets a plain prefetch of its HTML. Browsers without speculation
      rules ignore the block.
    */}
    <script type="speculationrules" is:inline set:html={JSON.stringify({
      prerender: [{ where: { or: SECTION_PATHS.map((p) => ({ href_matches: p })) }, eagerness: 'moderate' }],
      prefetch: [{ where: { and: [{ href_matches: '/*' }, { not: { or: SECTION_PATHS.map((p) => ({ href_matches: p })) } }] }, eagerness: 'moderate' }],
    })} />

    {/*
      Coming from another page of this site, hold the first paint until the
      tab bar has been parsed (the header comes before it). A page change
      captures the incoming page at its first paint; without this, that could
      land before either bar had been parsed, and at random: the same click
      kept the bars solid on one run and blanked them for four frames on the
      next (both reproduced 2026-09-25).

      Added by script, and only for such a navigation, because the hold is not
      free: always on, first paint came ~135ms later at 4x CPU throttling
      (largest paint unchanged). A visit from a search result or a typed
      address has nothing to transition from, so it paints at once. It names
      the tab bar, not <main>: the hold lasts until the element's end tag, and
      pointed at <main> it held the paint for the whole page (+130 to +590ms).
      Chrome and Edge; elsewhere this does nothing.
    */}
    <script is:inline>
      (() => {
        const from = window.navigation?.activation?.from;
        if (!from || !from.url || new URL(from.url).origin !== location.origin) return;
        const hold = document.createElement('link');
        hold.rel = 'expect';
        hold.href = '#tabbar';
        hold.setAttribute('blocking', 'render');
        document.head.append(hold);
      })();
    </script>

    {/*
      The sliding "you are here" pill in the header and the tab bar. Defined
      once, here, and called from an inline script right after each list, so
      it is placed before the first paint and never jumps.

      Moving between pages, the pill starts where it was on the page just
      left and slides to its new place: the page being left writes its own
      position on the way out (pageswap, or a link click where pageswap is
      missing), and the new page reads it back in pagereveal, which runs
      after a prerendered page is activated and before its first frame.
      With no JavaScript the current link is still tinted by app.css.
    */}
    {/* The favourites count beside Favourites, filled in before the first
        paint. Left to the script at the end of <body>, the first frame of
        every page drew the header without it and then shifted Feedback 20px
        right a frame later, and the pill was measured before the shift. */}
    <script is:inline define:vars={{ FAV_KEY: FAVORITES_KEY }}>
      window.nhakoFavBadges = (root) => {
        let n = 0;
        try { const v = JSON.parse(localStorage.getItem(FAV_KEY) || '[]'); if (Array.isArray(v)) n = v.filter((x) => typeof x === 'string').length; } catch { /* none */ }
        for (const badge of root?.querySelectorAll('[data-fav-count]') ?? []) {
          badge.textContent = String(n);
          badge.hidden = n === 0;
        }
      };
    </script>
    <script is:inline>
      window.nhakoIndicator = (root) => {
        window.nhakoFavBadges?.(root);
        const list = root.querySelector('[data-ind-list]');
        const ind = list?.querySelector('[data-ind]');
        const current = list?.querySelector('[data-ind-key][aria-current="page"], [data-ind-key][data-ind-current]');
        if (!ind || !current) return;
        const KEY = 'nhako:ind:' + list.dataset.indList;

        const place = (el) => {
          const a = el.getBoundingClientRect();
          const l = list.getBoundingClientRect();
          // Relative to the list's padding box, where the pill is positioned:
          // the tab bar's pill has a 1px border.
          list.style.setProperty('--ind-x', (a.left - l.left - list.clientLeft + list.scrollLeft).toFixed(1) + 'px');
          list.style.setProperty('--ind-w', a.width.toFixed(1) + 'px');
          list.style.setProperty('--ind-y', (a.top - l.top - list.clientTop).toFixed(1) + 'px');
          list.style.setProperty('--ind-h', a.height.toFixed(1) + 'px');
        };
        const settle = () => { delete list.dataset.indAnim; place(current); list.dataset.indReady = ''; };

        const arrive = () => {
          let from = null;
          try {
            const saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
            sessionStorage.removeItem(KEY);
            if (saved && Date.now() - saved.t < 10000) from = list.querySelector('[data-ind-key="' + saved.k + '"]');
          } catch { /* storage blocked: no slide, the pill is simply there */ }
          if (!from || from === current || !list.offsetWidth) return settle();
          delete list.dataset.indAnim;
          place(from);
          list.dataset.indReady = '';
          void ind.offsetWidth;
          list.dataset.indAnim = '';
          place(current);
        };

        const leave = () => {
          try { sessionStorage.setItem(KEY, JSON.stringify({ k: current.dataset.indKey, t: Date.now() })); } catch { /* fine */ }
        };

        settle();
        if ('onpagereveal' in window) addEventListener('pagereveal', arrive);
        if ('onpageswap' in window) addEventListener('pageswap', leave);
        else document.addEventListener('click', (e) => {
          const a = e.target instanceof Element ? e.target.closest('a[href]') : null;
          if (a && !e.defaultPrevented && a.origin === location.origin && !a.target) leave();
        });
        addEventListener('resize', () => requestAnimationFrame(settle));
      };
    </script>

    {/*
      Blocking, inline, before first paint. The old build resolved the theme in
      a useEffect that only ever ran on the homepage, so loading a tool page
      directly ignored the saved theme entirely, and even on the homepage the
      class landed after hydration, flashing the wrong theme on every load.

      Light is the default for everyone, whatever the operating system prefers
      (Kim's call, 2026-09-25). Dark is only ever an explicit choice, made with
      the toggle in the nav and remembered from then on.
    */}
    <script is:inline>
      (() => {
        try {
          document.documentElement.dataset.theme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
        // The status bar and an installed app's title bar follow the page from
        // the first frame, not from whenever the toggle's script loads.
        if (document.documentElement.dataset.theme === 'dark') {
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#0b0b0e');
        }
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <ButterflySky />
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-on">
      {t.skip}
    </a>
    <Nav locale={locale} path={path} alternates={alternates} />
    {/* The tab bar is fixed to the bottom of the screen but sits here, before
        the page, on purpose. A page change captures the new page as soon as
        it can paint, which can be before the parser reaches the end of a long
        page: at the end of <body> the bar was missing from that capture, so
        it vanished for a few frames, faded back in with the page and never
        slid its current-tab capsule (screen recording, 2026-09-25). */}
    <TabBar locale={locale} path={path} alternates={alternates} />
    <main id="main" class="flex-1 w-full">
      <slot />
    </main>
    <Footer locale={locale} />
    <InstallPrompt locale={locale} />

    {/*
      Favourites: every star on the page and the count beside Favourites in
      the nav. Inline rather than bundled on purpose. A bundled module is a
      separate request that holds DOMContentLoaded back, and this runs on
      every page, including the feedback form whose "typed before the page
      loaded" test caught exactly that. The storage format itself lives in
      src/lib/favorites.ts, which the favourites page and the tests use; the
      key and event names come from there so the two cannot drift.
    */}
    <script is:inline define:vars={{ KEY: FAVORITES_KEY, EVENT: FAVORITES_EVENT }}>
      (() => {
        const read = () => {
          try {
            const v = JSON.parse(localStorage.getItem(KEY) || '[]');
            return Array.isArray(v) ? v.filter((x) => typeof x === 'string') : [];
          } catch { return []; }
        };
        const sync = () => {
          const list = read();
          for (const btn of document.querySelectorAll('[data-fav]')) {
            const on = list.includes(btn.dataset.fav);
            btn.hidden = false;
            btn.setAttribute('aria-pressed', String(on));
            btn.querySelector('[data-fav-on]')?.toggleAttribute('hidden', !on);
            btn.querySelector('[data-fav-off]')?.toggleAttribute('hidden', on);
          }
          for (const badge of document.querySelectorAll('[data-fav-count]')) {
            badge.textContent = String(list.length);
            badge.hidden = list.length === 0;
          }
        };
        document.addEventListener('click', (event) => {
          const btn = event.target instanceof Element ? event.target.closest('[data-fav]') : null;
          if (!btn) return;
          event.preventDefault();
          const list = read();
          const on = !list.includes(btn.dataset.fav);
          const next = on ? [...list, btn.dataset.fav] : list.filter((x) => x !== btn.dataset.fav);
          try { localStorage.setItem(KEY, JSON.stringify(next)); } catch { /* blocked: this visit still updates */ }
          dispatchEvent(new CustomEvent(EVENT));
          btn.classList.remove('fav-pop');
          if (on) { void btn.offsetWidth; btn.classList.add('fav-pop'); }
        });
        addEventListener(EVENT, sync);
        addEventListener('storage', (e) => { if (e.key === KEY) sync(); });
        // Prerendered on hover, shown later: a star tapped in between counts.
        document.addEventListener('prerenderingchange', sync);
        sync();
      })();
    </script>

    <script is:inline>
      // Offline support. Registered after load so it never competes with the
      // page's own resources for bandwidth on a first visit.
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {
            // Unsupported, blocked, or a non-secure origin. The site works
            // exactly the same without it.
          });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border-width: 0;
  }
  .focus\:not-sr-only:focus {
    position: static; width: auto; height: auto; margin: 0;
    overflow: visible; clip: auto; white-space: normal;
  }
</style>
