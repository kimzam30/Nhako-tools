---
import '../styles/tokens.css';
import Nav from '../components/astro/Nav.astro';
import Footer from '../components/astro/Footer.astro';
import { LANG, LOCALES, localePath, ui, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /**
   * The page's path WITHOUT a locale prefix, e.g. "/pdf/merge". The canonical
   * URL, the hreflang alternates and the language switch are all built from
   * it, so the English and Malay versions always point at each other.
   */
  path: string;
  /** False for pages with no translated twin (the 404). */
  alternates?: boolean;
  keywords?: string[];
  jsonLd?: Record<string, unknown>;
  /** Category slug, used to pick the social preview image. */
  category?: string;
  /** Full <title> override. Defaults to "<title> | Nhako Tools". */
  documentTitle?: string;
  /** Keep a page out of search results (and out of the sitemap, see astro.config.mjs). */
  noindex?: boolean;
}

const { title, description, path, keywords, jsonLd, category, documentTitle, noindex = false, locale = 'en', alternates = true } = Astro.props;
const t = ui(locale);
const site = Astro.site ?? new URL('https://tools.nhako.com');
const canonical = new URL(localePath(locale, path), site);

// The <title> is also the search result headline, and "Merge PDF" alone is
// word for word what every competitor ranks with. The page name still leads,
// so a narrow tab shows the part people scan for; the brand trails.
const tabTitle = documentTitle ?? (title === 'Nhako Tools' ? title : `${title} | Nhako Tools`);

// Social cards have no such context, so they keep the brand.
const socialTitle = title === 'Nhako Tools' ? title : `${title} · Nhako Tools`;
const ogImage = new URL(`/og/${category ?? 'default'}.png`, site);

/* The two latin subsets the site actually paints with, preloaded so the
   fallback-to-webfont swap closes before first paint.

   Why: @fontsource ships `font-display: swap`. With the old 11px/13px ramp the
   swap moved text too little to register; raising the ramp on 2026-09-23 pushed
   it over Lighthouse's reporting floor and CLS went from 0 to 0.002 on /pdf.
   Blocking the font files takes it back to exactly 0, which is what identified
   the cause. The other subsets (latin-ext, cyrillic, greek, vietnamese) are not
   preloaded: nothing on this site renders in them by default. */
import instrumentSansLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import jetBrainsMonoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
---

<!doctype html>
<html lang={LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tabTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonical.href} />
    {alternates && LOCALES.map((l) => (
      <link rel="alternate" hreflang={LANG[l]} href={new URL(localePath(l, path), site).href} />
    ))}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(path, site).href} />}
    <link rel="preload" as="font" type="font/woff2" href={instrumentSansLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jetBrainsMonoLatin} crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Nhako Tools" />
    <meta property="og:locale" content={locale === 'ms' ? 'ms_MY' : 'en_MY'} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0b0b0e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {/*
      Vercel Web Analytics: cookieless, no personal data, and served from this
      same origin (/_vercel/insights), so it needs no CORS or COEP exception.
      Production builds only; the path does not exist in dev or local preview.
      It records page views, never files or tool input. See /privacy.
    */}
    {import.meta.env.PROD && (
      <>
        <script is:inline>window.va = window.va || function (...args) { (window.vaq = window.vaq || []).push(args); };</script>
        <script is:inline defer src="/_vercel/insights/script.js"></script>
      </>
    )}

    {/*
      Blocking, inline, before first paint. The old build resolved the theme in
      a useEffect that only ever ran on the homepage, so loading a tool page
      directly ignored the saved theme entirely, and even on the homepage the
      class landed after hydration, flashing the wrong theme on every load.
    */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-on">
      {t.skip}
    </a>
    <Nav locale={locale} path={path} alternates={alternates} />
    <main id="main" class="flex-1 w-full">
      <slot />
    </main>
    <Footer locale={locale} />

    <script is:inline>
      // Offline support. Registered after load so it never competes with the
      // page's own resources for bandwidth on a first visit.
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {
            // Unsupported, blocked, or a non-secure origin. The site works
            // exactly the same without it.
          });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border-width: 0;
  }
  .focus\:not-sr-only:focus {
    position: static; width: auto; height: auto; margin: 0;
    overflow: visible; clip: auto; white-space: normal;
  }
</style>
