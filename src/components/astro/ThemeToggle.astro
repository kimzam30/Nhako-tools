---
// Vanilla, not a React island. A theme toggle in the global nav would
// otherwise pull the whole React runtime onto every page on the site,
// including the static ones, which is exactly what a site selling itself on
// speed must not do.
//
// Two forms of one control: `icon` in the header on a tablet or desktop, and
// `row`, a labelled switch in the phone's More sheet, where the header has no
// room for it. Both flip the same setting and stay in step.
import { ui, type Locale } from '../../i18n';

interface Props { locale: Locale; variant?: 'icon' | 'row' }
const { variant = 'icon' } = Astro.props;
const t = ui(Astro.props.locale);
---
{variant === 'icon' ? (
  <button
    type="button"
    id="theme-toggle"
    data-theme-toggle
    class="grid size-8 place-items-center rounded border border-border text-muted transition-colors duration-[120ms] hover:border-border-strong hover:text-text pointer-coarse:size-11"
    aria-label={t.switchTheme}
    data-to-light={t.switchToLight}
    data-to-dark={t.switchToDark}
  >
    {/* `hidden` is not a valid SVG attribute, so each icon sits in a span that carries it. */}
    <span data-icon="light" class="grid place-items-center">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" stroke-linejoin="round" />
      </svg>
    </span>
    <span data-icon="dark" class="grid place-items-center" hidden>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round" />
      </svg>
    </span>
  </button>
) : (
  <button type="button" role="switch" aria-checked="false" data-theme-toggle class="sheet-row">
    <span class="grid size-[30px] shrink-0 place-items-center rounded-md bg-text text-bg" aria-hidden="true">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" stroke-linejoin="round" /></svg>
    </span>
    <span class="flex-1">{t.darkMode}</span>
    {/* The switch track. Pressed state comes from aria-checked, so there is
        exactly one source of truth and a screen reader hears it. */}
    <span aria-hidden="true" class="theme-switch relative h-[31px] w-[51px] shrink-0 rounded-full bg-border-strong transition-colors duration-200">
      <span class="absolute left-0.5 top-0.5 size-[27px] rounded-full bg-white shadow-[0_2px_4px_rgb(0_0_0/0.2)] transition-transform duration-200"></span>
    </span>
  </button>
)}

<script>
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLElement>('[data-theme-toggle]')];
  // The browser's own chrome (Android's status bar, Safari's tab tint, an
  // installed app's title bar) takes its colour from this tag, so it follows
  // the page into dark rather than staying a white strip above it.
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  function sync() {
    const dark = root.dataset.theme === 'dark';
    for (const button of buttons) {
      if (button.getAttribute('role') === 'switch') {
        button.setAttribute('aria-checked', String(dark));
        continue;
      }
      button.querySelector('[data-icon="light"]')?.toggleAttribute('hidden', dark);
      button.querySelector('[data-icon="dark"]')?.toggleAttribute('hidden', !dark);
      const label = dark ? button.dataset.toLight : button.dataset.toDark;
      if (label) button.setAttribute('aria-label', label);
    }
    meta?.setAttribute('content', dark ? '#0b0b0e' : '#ffffff');
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch { /* blocked storage */ }
      sync();
    });
  }

  sync();
</script>

<style is:global>
  [data-theme-toggle][aria-checked='true'] .theme-switch { background: var(--accent); }
  [data-theme-toggle][aria-checked='true'] .theme-switch > span { transform: translateX(20px); }
</style>
