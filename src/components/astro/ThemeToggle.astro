---
// Vanilla, not a React island. A theme toggle in the global nav would
// otherwise pull the whole React runtime onto every page on the site,
// including the static ones — which is exactly what a site selling itself on
// speed must not do.
---
<button
  type="button"
  id="theme-toggle"
  class="grid size-8 place-items-center rounded border border-border text-muted transition-colors duration-[120ms] hover:border-border-strong hover:text-text"
  aria-label="Switch theme"
>
  <svg data-icon="light" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" stroke-linejoin="round" />
  </svg>
  <svg data-icon="dark" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden>
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round" />
  </svg>
</button>

<script>
  const button = document.getElementById('theme-toggle');
  const root = document.documentElement;

  function sync() {
    const dark = root.dataset.theme === 'dark';
    button?.querySelector('[data-icon="light"]')?.toggleAttribute('hidden', dark);
    button?.querySelector('[data-icon="dark"]')?.toggleAttribute('hidden', !dark);
    button?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`);
  }

  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch { /* blocked storage */ }
    sync();
  });

  sync();
</script>
