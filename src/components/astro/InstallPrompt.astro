---
/**
 * Tells people the site installs as an app, on a phone, a tablet or a laptop.
 *
 * Each browser installs differently, so one card carries four bodies and the
 * script shows the one that is true here:
 *   native  Chrome, Edge, Samsung Internet, Android: the browser hands over its
 *           own install dialog (`beforeinstallprompt`), so one button installs.
 *   ios     iPhone and iPad, in any browser: there is no install API; the
 *           Share sheet's Add to Home Screen is the only way, so show it.
 *   mac     Safari 17 or later on a Mac: File, then Add to Dock.
 *   done    Already running as the installed app.
 * Anywhere else (Firefox on a desktop, an in-app browser inside Instagram or
 * TikTok) nothing can be installed, so nothing is offered: no card, and the
 * "Install app" entries in the footer and the More sheet stay hidden.
 *
 * When it appears on its own: never on a first, quick visit. On a second page
 * view it waits 2.5s; on a first visit, only after 20s on the page, which is
 * someone actually using a tool. "Not now" or the close button puts it away
 * for 14 days, and installing puts it away for good.
 *
 * `popover="manual"`: a banner, not a modal. It sits in the top layer above
 * the tab bar without blocking the page, and only its own buttons close it.
 * Inline rather than bundled, for the reason in BaseLayout: every-page
 * scripts that are separate files hold DOMContentLoaded back.
 */
import { ui, type Locale } from '../../i18n';

interface Props { locale: Locale }
const t = ui(Astro.props.locale);
const shareIcon = '<svg class="inline size-[1.15em] -translate-y-px align-middle text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 3v12M8 7l4-4 4 4M7 10H5v11h14V10h-2"/></svg>';
---

<div id="install-card" popover="manual" class="install-card" role="dialog" aria-labelledby="install-title" aria-describedby="install-body">
  <div class="flex items-start gap-3">
    <img src="/icons/icon-192.png" alt="" width="48" height="48" class="size-12 shrink-0 rounded-[11px] border border-border" />
    <div class="min-w-0 flex-1 pr-8">
      <h2 id="install-title" class="text-base font-semibold">{t.installTitle}</h2>
      <p id="install-body" class="mt-0.5 text-sm leading-snug text-muted">{t.installBody}</p>
    </div>
    <button type="button" data-install-later aria-label={t.close} class="absolute right-1.5 top-1.5 grid size-11 place-items-center rounded-md text-muted transition-colors hover:text-text active:bg-sunken">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>

  <div data-install-mode="native" hidden class="mt-4 flex gap-2">
    <button type="button" data-install-go class="h-11 flex-1 rounded-lg bg-accent px-4 text-base font-semibold text-accent-on transition-colors hover:bg-accent-hover">{t.installAction}</button>
    <button type="button" data-install-later class="h-11 rounded-lg border border-border px-4 text-base font-semibold text-muted transition-colors hover:text-text active:bg-sunken">{t.installLater}</button>
  </div>

  <div data-install-mode="ios" hidden class="mt-4">
    <ol class="install-steps">
      {t.installStepsIos.map((step, i) => (
        <li><span class="install-step-n">{i + 1}</span><span>{step}{i === 0 && <Fragment set:html={` ${shareIcon}`} />}</span></li>
      ))}
    </ol>
    <button type="button" data-install-later class="mt-3 h-11 w-full rounded-lg border border-border text-base font-semibold text-muted active:bg-sunken">{t.installLater}</button>
  </div>

  <div data-install-mode="mac" hidden class="mt-4">
    <ol class="install-steps">
      {t.installStepsMac.map((step, i) => (
        <li><span class="install-step-n">{i + 1}</span><span>{step}</span></li>
      ))}
    </ol>
    <button type="button" data-install-later class="mt-3 h-11 w-full rounded-lg border border-border text-base font-semibold text-muted hover:text-text">{t.installLater}</button>
  </div>

  <p data-install-mode="done" hidden class="mt-3 text-sm text-ok">{t.installedAlready}</p>
  <p data-install-mode="installed" hidden class="mt-3 text-sm text-ok">{t.installDone}</p>
</div>

<script is:inline>
  (() => {
    const card = document.getElementById('install-card');
    if (!card || typeof card.showPopover !== 'function') return;

    const SNOOZE = 'nhako:install-snooze';
    const VIEWS = 'nhako:views';
    const DAY = 864e5;
    const get = (k) => { try { return localStorage.getItem(k); } catch { return null; } };
    const set = (k, v) => { try { localStorage.setItem(k, v); } catch { /* private mode: this visit only */ } };

    const ua = navigator.userAgent;
    const standalone = matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
    // iPadOS reports itself as a Mac; the touch points give it away.
    const ios = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
    // Webviews inside social apps have no Share sheet entry for the page.
    const inApp = /FBAN|FBAV|Instagram|Line\/|TikTok|musical_ly|Snapchat|Twitter/i.test(ua);
    const safariVersion = Number((ua.match(/Version\/(\d+)/) || [])[1] || 0);
    const macSafari = !ios && /Macintosh/.test(ua) && !/Chrome|Chromium|CriOS|Edg|Firefox|OPR/.test(ua) && safariVersion >= 17;

    let deferred = null;
    let installed = false;
    const mode = () =>
      installed ? 'installed'
      : standalone ? 'done'
      : deferred ? 'native'
      : ios && !inApp ? 'ios'
      : macSafari ? 'mac'
      : null;

    // Entry points (the footer link, the More sheet row) exist only where an
    // install can actually happen. They start hidden in the HTML.
    const reveal = () => {
      const m = mode();
      for (const el of document.querySelectorAll('[data-install-row]')) el.hidden = !m || m === 'done';
    };

    const show = (auto) => {
      const m = mode();
      if (!m || (auto && (m === 'done' || m === 'installed'))) return;
      for (const el of card.querySelectorAll('[data-install-mode]')) el.hidden = el.dataset.installMode !== m;
      if (!card.matches(':popover-open')) card.showPopover();
      card.querySelector('[data-install-mode]:not([hidden]) button')?.focus({ preventScroll: true });
    };
    const hide = () => { if (card.matches(':popover-open')) card.hidePopover(); };
    const snooze = (days) => set(SNOOZE, String(Date.now() + days * DAY));

    const views = Number(get(VIEWS) || 0) + 1;
    set(VIEWS, String(views));
    let timer = 0;
    const scheduleAuto = () => {
      if (standalone || Number(get(SNOOZE) || 0) > Date.now()) return;
      clearTimeout(timer);
      timer = setTimeout(() => {
        // Never over another sheet, and never while someone is typing.
        const typing = document.activeElement?.matches('input, textarea, select, [contenteditable]');
        if (!document.querySelector(':popover-open') && !typing) show(true);
      }, views >= 2 ? 2500 : 20000);
    };

    addEventListener('beforeinstallprompt', (event) => {
      event.preventDefault();
      deferred = event;
      reveal();
      scheduleAuto();
    });
    addEventListener('appinstalled', () => {
      deferred = null;
      installed = true;
      snooze(3650);
      reveal();
    });

    document.addEventListener('click', async (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      if (target.closest('[data-install-open]')) {
        document.getElementById('more-sheet')?.hidePopover?.();
        clearTimeout(timer);
        show(false);
      } else if (target.closest('[data-install-later]')) {
        snooze(14);
        hide();
      } else if (target.closest('[data-install-go]') && deferred) {
        const prompt = deferred;
        deferred = null;
        hide();
        prompt.prompt();
        const choice = await prompt.userChoice.catch(() => ({ outcome: 'dismissed' }));
        if (choice.outcome !== 'accepted') snooze(14);
        reveal();
      }
    });

    reveal();
    if (mode() === 'ios' || mode() === 'mac') scheduleAuto();
  })();
</script>
