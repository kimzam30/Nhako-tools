---
/**
 * The NeraOS sky: pixel butterflies drifting behind every page.
 *
 * The flight is NeraOS's `startButterflies` (js/app.js) ported line for line:
 * a random walk on the heading, a sine bob on top, wrap-around at the edges,
 * the body turned to face the way it is flying, and each sprite flapping on
 * its own period between 0.3s and 0.55s. Count, scale and speed are the
 * desktop values NeraOS uses (7 butterflies, scale 2 to 4, speed 0.55).
 *
 * It sits BEHIND the page (z-index -1 on the root stacking context), so
 * panels, the drop zone and every control paint over it and nothing on a tool
 * page is ever covered. pointer-events is none throughout.
 *
 * Inline rather than a bundled island: the homepage ships no site JS bundle
 * and this keeps it that way. Reduced motion gets no sky at all, because a
 * butterfly frozen mid-page reads as a stray mark, not a background.
 */
import { BUTTERFLY_COLORS, PALETTE, SPRITES } from '../../lib/butterfly';

const rows = SPRITES.butterfly;
---

<div id="sky" aria-hidden="true"></div>

<script is:inline define:vars={{ rows, palette: PALETTE, colors: BUTTERFLY_COLORS }}>
  (() => {
    const sky = document.getElementById('sky');
    if (!sky || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const rand = (a, b) => a + Math.random() * (b - a);
    const cache = new Map();
    const spriteURL = (overrides) => {
      const key = JSON.stringify(overrides);
      if (cache.has(key)) return cache.get(key);
      const canvas = document.createElement('canvas');
      canvas.width = rows[0].length;
      canvas.height = rows.length;
      const ctx = canvas.getContext('2d');
      rows.forEach((row, y) => {
        [...row].forEach((ch, x) => {
          if (ch === '.') return;
          ctx.fillStyle = overrides[ch] || palette[ch];
          ctx.fillRect(x, y, 1, 1);
        });
      });
      const url = canvas.toDataURL();
      cache.set(key, url);
      return url;
    };

    const count = 7, minScale = 2, maxScale = 4, speed = 0.55;
    let W = innerWidth, H = innerHeight;

    // The sky carries over from page to page. Every page used to scatter the
    // butterflies to fresh random spots, so each navigation made all seven
    // jump at once, and the page transition showed both sets. The page being
    // left writes where each one is; the next page picks them up there.
    const KEY = 'nhako:sky';
    const saved = () => {
      try {
        const v = JSON.parse(sessionStorage.getItem(KEY) || 'null');
        return Array.isArray(v) && v.length === count ? v : null;
      } catch { return null; }
    };
    const start = saved();
    const flies = [];
    for (let i = 0; i < count; i++) {
      const s = start?.[i];
      const wrap = document.createElement('div');
      wrap.className = 'bfly flap';
      const scale = s?.s ?? Math.round(rand(minScale, maxScale));
      const flap = s?.d ?? rand(0.3, 0.55).toFixed(2);
      const img = new Image();
      img.src = spriteURL(colors[i % colors.length]);
      img.width = rows[0].length * scale;
      img.height = rows.length * scale;
      img.className = 'px';
      img.alt = '';
      img.draggable = false;
      img.style.animationDuration = flap + 's';
      wrap.appendChild(img);
      sky.appendChild(wrap);
      flies.push({ el: wrap, s: scale, d: flap, x: s?.x ?? rand(0, W), y: s?.y ?? rand(0, H), a: s?.a ?? rand(0, Math.PI * 2), v: s?.v ?? rand(0.5, 1) * speed, phase: s?.phase ?? rand(0, 10) });
    }

    const save = () => {
      try {
        sessionStorage.setItem(KEY, JSON.stringify(flies.map(({ s, d, x, y, a, v, phase }) => ({ s, d, x, y, a, v, phase }))));
      } catch { /* storage blocked: the next page scatters them afresh */ }
    };
    // pageswap runs on the page being left, before the next one is shown;
    // pagehide is the fallback where it does not exist.
    addEventListener('onpageswap' in window ? 'pageswap' : 'pagehide', save);
    // A page prerendered on hover built its sky back then. By the time it is
    // shown the butterflies have flown on, so it takes up the latest spots.
    addEventListener('pagereveal', () => {
      const now = saved();
      if (now) flies.forEach((f, i) => Object.assign(f, { x: now[i].x, y: now[i].y, a: now[i].a }));
    });

    addEventListener('resize', () => { W = innerWidth; H = innerHeight; });

    // Wall-clock time, not time since this page loaded, so the bob carries on
    // in phase across a navigation instead of restarting.
    const tick = (frame) => {
      const t = performance.timeOrigin + frame;
      for (const f of flies) {
        f.a += (Math.random() - 0.5) * 0.12;
        f.x += Math.cos(f.a) * f.v;
        f.y += Math.sin(f.a) * f.v + Math.sin(t * 0.004 + f.phase) * 0.35;
        if (f.x < -60) f.x = W + 40;
        if (f.x > W + 60) f.x = -40;
        if (f.y < -60) f.y = H + 40;
        if (f.y > H + 60) f.y = -40;
        const deg = (f.a * 180) / Math.PI + 90;
        f.el.style.transform = `translate(${f.x.toFixed(1)}px, ${f.y.toFixed(1)}px) rotate(${deg.toFixed(1)}deg)`;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  })();
</script>
