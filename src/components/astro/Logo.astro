---
/**
 * The Nhako Tools mark: the pixel hammer mascot, the same file the PWA
 * installs (scripts/mascot-art.mjs draws it, `npm run icons` writes it).
 *
 * Always 32px. The art is a 48px grid, so 32 is not a whole step of it and
 * `px` (pixelated) would drop whole rows; the browser's smooth downscale of
 * the 192px PNG (an exact 6, 3 or 2 on 1x, 2x and 3x screens) keeps every
 * feature. Decorative: the link carries the name.
 */
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<img
  src="/icons/icon-192.png"
  alt=""
  width="32"
  height="32"
  decoding="async"
  class:list={['size-8 shrink-0', className]}
  draggable="false"
/>
