---
import type { ToolMeta } from '../../tools/types';
import ToolIcon from './ToolIcon.astro';
import FavButton from './FavButton.astro';
import { localeFromPath } from '../../i18n';

/** Precomputed by the view: localising a variant is the caller's job, exactly
 *  as localising the tool is. */
export interface Preset {
  href: string;
  /** Chip text. Short by design: '500 KB', not 'Compress PDF to 500 KB'. */
  short: string;
  /** Full name, used as the chip's accessible name. */
  name: string;
}

interface Props {
  tool: ToolMeta;
  href: string;
  presets?: Preset[];
  /** Why this tool appears here. Used by the Malaysia collection, where the
   *  portal context is the reason the entry earns its place. */
  context?: string;
  /** The job group this card is filed under on the current page, for the
   *  category page's filter chips. */
  group?: string;
}

const { tool, href, presets = [], context, group } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
---
{/*
  The directory primitive, as a card.

  This replaces the bordered row the browse layer shipped in September. That row
  argued, correctly at the time, that at 43 tools a padded card shows six per
  screen where a row shows about fourteen, and that this is an instrument panel
  rather than a shop window. What changed is the 43 marks: a card carrying a
  mark is a different proposition from a card carrying two lines of text,
  because the mark does the scanning work that the tight row used to do with
  alignment. The cost is real and measured in .design/redesign/TASKS.md.

  `data-tool-card`, `data-name`, `data-keywords` and `data-category` are the
  homepage filter's contract and must not change. The mark lives inside the
  filtered element so it hides and shows with its card.

  The chips sit outside the anchor because a link inside a link is invalid HTML,
  which is why this is a <div> wrapping an <a> rather than one big <a>. The
  hover state is on the wrapper, so the whole card responds as one object even
  though only part of it is the link.

  No shadow. Depth is a border, a surface and an inset hairline: machined, not
  floating. See DESIGN_BRIEF.md amendment 2.

  On a phone (below 640px) it is the "Popular with students" card: the mark in
  its own rounded tile, the name, and nothing else, two to a row. The blurb and
  the star go (Kim, 2026-09-25): the name says what the tool does, the blurb
  doubled every card's height, and a 44px star on a 170px card is a quarter of
  the card that does not open the tool. Starring on a phone happens on the
  tool's own page, or in Favourites' "Choose your tools" list. A card with
  size presets spans both columns, so its chips sit on one line instead of
  stacking. Under 360px (an iPhone SE, small Androids) the tile sits above the
  name, centred, as an app icon does: beside it, a 70px line could not hold
  "Teleprompter" or "PowerPoint".
*/}
<div
  data-tool-card
  data-reveal
  data-name={tool.name.toLowerCase()}
  data-keywords={tool.keywords.join(' ')}
  data-category={tool.category}
  data-group-id={group}
  class:list={[
    'group/card relative flex flex-col rounded-lg border border-border bg-surface shadow-[inset_0_1px_0_var(--edge)] transition-colors duration-[120ms] hover:border-accent focus-within:border-accent',
    // The pressed state is the whole card darkening, as the popular cards do.
    'max-sm:rounded-xl has-[>a:active]:bg-sunken',
    presets.length > 0 && 'max-sm:col-span-2',
  ]}
>
  <a href={href} class="flex flex-1 gap-2.5 rounded-lg p-3 pr-11 max-sm:items-center max-sm:rounded-xl max-sm:p-2.5 max-xs:flex-col max-xs:gap-2 max-xs:text-center">
    {/* The tile exists only on a phone; from 640px it steps aside (contents)
        and the bare mark is nudged so its optical centre sits on the name's
        first baseline. */}
    <span class="contents max-sm:grid max-sm:size-9 max-sm:shrink-0 max-sm:place-items-center max-sm:rounded-lg max-sm:border max-sm:border-border max-sm:bg-bg">
      <ToolIcon tool={tool} class="mt-0.5 group-hover/card:text-accent max-sm:mt-0" />
    </span>

    <span class="flex min-w-0 flex-col gap-0.5">
      <span class="text-sm font-medium transition-colors group-hover/card:text-accent max-sm:font-semibold max-sm:leading-snug">
        {tool.name}
      </span>
      <span class="text-xs leading-snug text-muted max-sm:hidden">{context ?? tool.blurb}</span>
    </span>
  </a>

  {/* A sibling of the link, never inside it: a button in a link is invalid
      and would navigate on every star. */}
  <FavButton
    id={`${tool.category}/${tool.slug}`}
    name={tool.name}
    locale={locale}
    class="absolute right-1.5 top-1.5 max-sm:hidden"
  />

  {presets.length > 0 && (
    /* Indented to the blurb, so the chips read as belonging to the name above
       them rather than to the card edge. The card that owns presets is taller
       than its neighbours, which is honest: it leads somewhere they do not.
       On a phone they start at the tile's edge instead: indented, Compress
       PDF's five sizes wrapped to a second line at 390px. */
    <ul class="flex flex-wrap gap-1.5 pb-3 pr-3 pl-[calc(0.75rem+var(--mark-gutter)-0.5rem)] max-sm:pb-2.5 max-sm:pl-2.5 max-sm:pr-2.5">
      {presets.map((p) => (
        <li>
          {/*
            Visible text is the short form; the accessible name is the full one,
            so a screen reader hears "Compress PDF to 500 KB" rather than an
            orphaned "500 KB". Sizes are numbers, so they take the mono face.
            The touch target grows to 44px on a coarse pointer only, which keeps
            the card dense on a mouse and thumb-sized on a phone.
          */}
          <a
            href={p.href}
            aria-label={p.name}
            class="inline-flex items-center rounded border border-border px-2 py-1 font-mono text-2xs text-muted transition-colors duration-[120ms] hover:border-accent hover:text-accent pointer-coarse:min-h-11 pointer-coarse:px-3"
          >
            {p.short}
          </a>
        </li>
      ))}
    </ul>
  )}
</div>
