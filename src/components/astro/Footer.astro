---
import Logo from './Logo.astro';
import { NAV_CATEGORIES } from '../../tools/groups';
import { categoryLabel, localePath, ui, type Locale } from '../../i18n';
import { community } from '../../i18n/community';
import CoffeeButton from './CoffeeButton.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui(locale);
const c = community(locale);

// Deliberately thin. The old footer carried nine links to pages that did not
// exist (Blog, Best practices, Pro experience, Contact, Legal…) plus three
// <div>s styled as social buttons. An empty footer is more honest.
const year = new Date().getFullYear();
---

<footer class="mt-12 border-t border-border">
  {/*
    A browse path at the foot of a long tool page. It is the one place a way
    back up into the catalogue belongs on a page that is otherwise about a
    single job.
  */}
  <nav aria-label={t.browseAll} class="mx-auto max-w-6xl px-4 pt-8 sm:px-6">
    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-xs text-muted">
      {NAV_CATEGORIES.map((c) => (
        <li><a class="inline-flex items-center transition-colors hover:text-accent pointer-coarse:min-h-11" href={localePath(locale, `/${c}`)}>{categoryLabel(c, locale)}</a></li>
      ))}
      <li><a class="inline-flex items-center transition-colors hover:text-accent pointer-coarse:min-h-11" href={localePath(locale, '/calc')}>{categoryLabel('calc', locale)}</a></li>
      <li><a class="inline-flex items-center transition-colors hover:text-accent pointer-coarse:min-h-11" href={localePath(locale, '/malaysia')}>{t.malaysia}</a></li>
    </ul>
  </nav>

  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p class="flex items-center gap-2">
      <Logo class="size-4 rounded-sm" />
      <span class="font-semibold text-text"><span class="text-accent">Nhako</span>Tools</span>
      <span>{t.footerLine}</span>
    </p>
    <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <li><a class="transition-colors hover:text-accent" href={localePath(locale, '/feedback')}>{c.feedback}</a></li>
      <li><CoffeeButton locale={locale} variant="text" /></li>
      <li><a class="transition-colors hover:text-accent" href={localePath(locale, '/about')}>{t.about}</a></li>
      <li><a class="transition-colors hover:text-accent" href={localePath(locale, '/privacy')}>{t.privacy}</a></li>
      <li>
        <a class="transition-colors hover:text-accent" href="https://github.com/kimzam30/Nhako-tools" rel="noopener noreferrer">
          {t.source}
        </a>
      </li>
      <li>MIT © {year}</li>
    </ul>
  </div>
</footer>
