---
import { TOOLS } from '../../tools/registry';
import { buildSearchIndex } from '../../tools/search-index';
import { ui, type Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui(locale);

// The index is serialised into the page rather than imported by the client
// script, so the full registry never ships to the browser as executable code.
// Keywords carry both languages, so "gabung" and "merge" both work anywhere.
const index = buildSearchIndex(locale);
---

<button
  type="button"
  id="palette-open"
  class="flex size-8 items-center justify-center gap-2 rounded border border-border text-xs text-muted transition-colors duration-[120ms] hover:border-border-strong hover:text-text pointer-coarse:size-11 xl:pointer-fine:w-auto xl:pointer-fine:px-2.5 app-shell:size-11 app-shell:border-transparent"
  aria-label={t.searchTools}
  aria-keyshortcuts="Control+K Meta+K"
  aria-haspopup="dialog"
>
  <svg class="size-[13px] app-shell:size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" stroke-linecap="round" />
  </svg>
  <span class="hidden xl:pointer-fine:inline">{t.search}</span>
  {/* The name starts with the visible word "Search" (WCAG 2.5.3), and the
      shortcut hint is hidden from screen readers, which read "⌘" as "place
      of interest sign". aria-keyshortcuts states it properly instead. */}
  <kbd id="palette-shortcut" aria-hidden="true" class="hidden rounded border border-border px-1 font-mono text-2xs xl:pointer-fine:inline">Ctrl K</kbd>
</button>

{/*
  On a phone the palette is a full screen, as search is in a native app: the
  field pinned at the top under the safe area, results filling the rest, and a
  Cancel button, because a phone has no Escape key and no margin to tap.
*/}
<div id="palette" hidden class="fixed inset-0 z-50 flex items-start justify-center bg-black/40 p-4 pt-[12vh] max-sm:bg-bg max-sm:p-0">
  <div role="dialog" aria-modal="true" aria-label={t.paletteLabel} class="w-full max-w-lg overflow-hidden rounded-lg border border-border bg-bg shadow-[var(--shadow-overlay)] max-sm:flex max-sm:h-dvh max-sm:max-w-none max-sm:flex-col max-sm:rounded-none max-sm:border-0 max-sm:pt-[env(safe-area-inset-top)] max-sm:shadow-none">
    <div class="flex items-center border-b border-border max-sm:gap-1 max-sm:px-3 max-sm:py-2">
      <label class="sr-only" for="palette-input">{t.searchTools}</label>
      <input
        id="palette-input" type="text" autocomplete="off" placeholder={t.searchPlaceholder(TOOLS.length)}
        role="combobox" aria-expanded="true" aria-controls="palette-list" enterkeyhint="go"
        class="min-w-0 flex-1 bg-transparent px-4 py-3 text-sm outline-none placeholder:text-muted max-sm:h-11 max-sm:rounded-lg max-sm:bg-sunken max-sm:px-3 max-sm:py-0"
      />
      <button type="button" id="palette-cancel" class="hidden h-11 shrink-0 px-2 text-base font-semibold text-accent max-sm:block">{t.close}</button>
    </div>
    <ul id="palette-list" role="listbox" aria-label={t.paletteResults} data-empty={t.paletteEmpty} class="max-h-80 overflow-y-auto p-1.5 max-sm:max-h-none max-sm:flex-1 max-sm:overscroll-contain"></ul>
  </div>
</div>

<script type="application/json" id="tool-index" set:html={JSON.stringify(index)}></script>

<script>
  import { searchTools, type SearchableTool } from '../react/search';

  const tools: (SearchableTool & { href: string })[] = JSON.parse(document.getElementById('tool-index')?.textContent ?? '[]');
  const openBtn = document.getElementById('palette-open');
  const overlay = document.getElementById('palette');
  const input = document.getElementById('palette-input') as HTMLInputElement | null;
  const list = document.getElementById('palette-list');

  // Show the shortcut for this platform: ⌘K on Apple devices, Ctrl K elsewhere.
  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    const hint = document.getElementById('palette-shortcut');
    if (hint) hint.textContent = '\u2318K';
  }

  const escape = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] ?? c);

  let active = 0;
  let results: typeof tools = [];

  function render() {
    if (!list) return;
    results = searchTools(tools, input?.value ?? '').slice(0, 8);
    if (active >= results.length) active = 0;

    // A listbox option must not contain interactive children, so the option
    // itself carries the content and the navigation, with no nested <a>.
    list.innerHTML = results.length === 0
      ? `<li class="px-3 py-6 text-center text-sm text-muted">${escape(list.dataset.empty ?? '')}</li>`
      : results.map((t, i) => `
          <li
            role="option"
            id="cmd-opt-${i}"
            aria-selected="${i === active}"
            data-index="${i}"
            data-href="${escape(t.href)}"
            class="flex min-h-11 cursor-pointer items-center gap-3 rounded px-3 py-2 active:bg-sunken ${i === active ? 'bg-sunken' : ''}"
          >
            <span class="text-sm font-medium">${escape(t.name)}</span>
            <span class="min-w-0 flex-1 truncate text-xs text-muted">${escape(t.blurb)}</span>
            <span class="text-2xs uppercase tracking-wider text-muted">${escape(t.category)}</span>
          </li>`).join('');

    for (const el of list.querySelectorAll<HTMLElement>('li[data-index]')) {
      // Only re-render when the highlight actually moves. render() replaces the
      // whole list through innerHTML, so re-running it for a mouseenter on the
      // already-active option destroyed the node under the cursor and the
      // click that followed landed on nothing.
      el.addEventListener('mouseenter', () => {
        const i = Number(el.dataset.index);
        if (i !== active) { active = i; render(); }
      });
      el.addEventListener('click', () => { location.href = el.dataset.href ?? '/'; });
    }

    // Point the combobox at the active option so screen readers follow along.
    input?.setAttribute('aria-activedescendant', results.length ? `cmd-opt-${active}` : '');
  }

  function setOpen(open: boolean) {
    overlay?.toggleAttribute('hidden', !open);
    if (open) {
      if (input) input.value = '';
      active = 0;
      render();
      requestAnimationFrame(() => input?.focus());
    } else {
      openBtn?.focus();
    }
  }

  openBtn?.addEventListener('click', () => setOpen(true));
  document.getElementById('palette-cancel')?.addEventListener('click', () => setOpen(false));
  overlay?.addEventListener('mousedown', (e) => { if (e.target === overlay) setOpen(false); });
  input?.addEventListener('input', render);

  input?.addEventListener('keydown', (e) => {
    // aria-modal promises focus stays in the dialog. The input is its only
    // tab stop (options are reached with the arrows), so Tab stays put.
    // Without this, Tab walked out to the theme toggle behind the overlay.
    if (e.key === 'Tab') { e.preventDefault(); return; }
    if (e.key === 'ArrowDown') { e.preventDefault(); active = Math.min(active + 1, results.length - 1); render(); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); active = Math.max(active - 1, 0); render(); }
    else if (e.key === 'Enter') { e.preventDefault(); const t = results[active]; if (t) location.href = t.href; }
  });

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      setOpen(overlay?.hasAttribute('hidden') ?? true);
    } else if (e.key === 'Escape' && !overlay?.hasAttribute('hidden')) {
      setOpen(false);
    }
  });
</script>
