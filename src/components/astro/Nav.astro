---
import { NAV_CATEGORIES } from '../../tools/groups';
import { categoryLabel, localePath, ui, type Locale } from '../../i18n';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import CommandPalette from './CommandPalette.astro';
import CoffeeButton from './CoffeeButton.astro';

interface Props { locale: Locale; path: string; alternates: boolean }
const { locale, path, alternates } = Astro.props;
const t = ui(locale);
const other: Locale = locale === 'en' ? 'ms' : 'en';
const home = localePath(locale, '/');

// The active item, so the row says where you are. A tool page marks its own
// category: /pdf/merge is still somewhere inside PDF.
const active = (segment: string) => path === `/${segment}` || path.startsWith(`/${segment}/`);

const items: { href: string; label: string; current: boolean; star?: boolean }[] = [
  { href: home, label: t.navHome, current: path === '/' },
  ...NAV_CATEGORIES.map((c) => ({ href: localePath(locale, `/${c}`), label: categoryLabel(c, locale), current: active(c) })),
  { href: localePath(locale, '/malaysia'), label: t.malaysia, current: path === '/malaysia' },
  { href: localePath(locale, '/favourites'), label: t.favorites, current: path === '/favourites', star: true },
  { href: localePath(locale, '/feedback'), label: t.navFeedback, current: path === '/feedback' },
];
---

<header class="vt-nav sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-sm">
  <nav class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6" aria-label={t.mainNav}>
    <a href={home} aria-label={t.home} class="vt-logo flex shrink-0 items-center gap-2 text-base font-bold tracking-tight">
      <Logo class="size-6 rounded-md" />
      {/* The wordmark yields to the category row on a phone. The mark still
          links home, and losing two words is a better trade than a nav that
          shows one category and looks like it has only one. */}
      <span class="hidden sm:inline"><span class="text-accent">Nhako</span>Tools</span>
    </a>

    {/*
      A scroll container, not a menu: no open state, no focus trap, no
      JavaScript. Below 768px this row used to be `hidden md:flex`, which left
      a phone with no category navigation at all, only the search button.
      Scrolling is the whole adaptation.

      It stays `flex-1 min-w-0` at every width. It used to become `md:flex-none`
      from 768px, which stopped it shrinking, and on a touch screen, where
      `pointer-coarse` pads every item, the row then outgrew the bar between
      768px and about 850px and pushed search, language and theme off the right
      edge, so every page scrolled sideways on an iPad held upright. Where
      there is room the two look identical, because the items are left aligned
      and `ml-auto` still holds the controls to the right.
    */}
    <ul data-nav-list class="-mx-1 flex min-w-0 flex-1 items-stretch gap-0.5 self-stretch overflow-x-auto px-1 [scrollbar-width:none] pointer-coarse:gap-1 [&::-webkit-scrollbar]:hidden">
      {items.map((item) => (
        <li class="relative flex shrink-0 items-center">
          {/*
            Where you are, said three ways so no one of them has to carry it:
            the label turns accent, a tinted pill sits behind it, and a bar
            sits on the header's bottom edge like a tab. aria-current says it
            to a screen reader. The bar is drawn inside the <li> because the
            list scrolls, and anything outside a scroll box gets clipped.
          */}
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class:list={[
              'nav-link flex scroll-mx-4 items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm font-semibold transition-colors duration-[120ms]',
              'pointer-coarse:min-h-11 pointer-coarse:px-3',
              item.current ? 'bg-accent-subtle text-accent' : 'text-muted hover:bg-sunken hover:text-text',
            ]}
          >
            {item.star && (
              <svg class="size-3.5" viewBox="0 0 24 24" fill={item.current ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
              </svg>
            )}
            {item.label}
            {item.star && (
              <span data-fav-count hidden class="min-w-4 rounded-full bg-accent px-1 text-center text-2xs leading-4 font-semibold text-accent-on tabular-nums"></span>
            )}
          </a>
          <span
            aria-hidden="true"
            class:list={[
              'pointer-events-none absolute inset-x-2 bottom-0 h-0.5 rounded-full bg-accent transition-transform duration-200',
              item.current ? 'scale-x-100' : 'scale-x-0',
            ]}
          ></span>
        </li>
      ))}
    </ul>

    <div class="ml-auto flex shrink-0 items-center gap-2">
      <CommandPalette locale={locale} />
      {alternates && (
        <a
          href={localePath(other, path)}
          hreflang={other}
          lang={other}
          aria-label={`${t.switchLanguageShort}, ${t.switchLanguageLabel}`}
          class="grid h-8 place-items-center rounded border border-border px-2 font-mono text-2xs font-semibold text-muted transition-colors duration-[120ms] hover:border-border-strong hover:text-text pointer-coarse:h-11 pointer-coarse:px-3"
        >
          {t.switchLanguageShort}
        </a>
      )}
      {/* Phones keep the coffee link in the footer: the bar is already full. */}
      <span class="hidden sm:contents"><CoffeeButton locale={locale} variant="icon" /></span>
      <ThemeToggle locale={locale} />
    </div>
  </nav>
</header>

<script is:inline>
  // On a phone the row scrolls, and the current page can sit off the right
  // edge. Bring it into view without scrolling the page itself.
  (() => {
    const list = document.querySelector('[data-nav-list]');
    const current = list?.querySelector('[aria-current="page"]');
    if (list && current && list.scrollWidth > list.clientWidth) {
      list.scrollLeft = Math.max(0, current.offsetLeft - (list.clientWidth - current.offsetWidth) / 2);
    }
  })();
</script>
