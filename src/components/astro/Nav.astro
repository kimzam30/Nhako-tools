---
import { CATEGORIES, CATEGORY_LABEL } from '../../tools/types';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import CommandPalette from './CommandPalette.astro';
---

<header class="vt-nav sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-sm">
  <nav class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6" aria-label="Main">
    <a href="/" class="vt-logo flex shrink-0 items-center gap-2 text-base font-bold tracking-tight">
      <Logo class="size-6 rounded-md" />
      <span><span class="text-accent">Nhako</span>Tools</span>
      <span
        class="runtime-dot ml-1 size-1.5 rounded-full bg-accent"
        title="Everything runs locally in your browser"
        aria-hidden="true"
      ></span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {CATEGORIES.map((c) => (
        <li>
          <a
            href={`/#${c}`}
            class="rounded px-2.5 py-1.5 text-sm text-muted transition-colors duration-[120ms] hover:bg-sunken hover:text-text"
          >
            {CATEGORY_LABEL[c]}
          </a>
        </li>
      ))}
    </ul>

    <div class="ml-auto flex items-center gap-2">
      <CommandPalette />
      <ThemeToggle />
    </div>
  </nav>
</header>
