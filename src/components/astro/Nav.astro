---
import { NAV_CATEGORIES } from '../../tools/groups';
import { categoryLabel, localePath, ui, type Locale } from '../../i18n';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import CommandPalette from './CommandPalette.astro';
import CoffeeButton from './CoffeeButton.astro';

interface Props { locale: Locale; path: string; alternates: boolean }
const { locale, path, alternates } = Astro.props;
const t = ui(locale);
const other: Locale = locale === 'en' ? 'ms' : 'en';
const home = localePath(locale, '/');

// The active item, so the row says where you are. A tool page marks its own
// category: /pdf/merge is still somewhere inside PDF.
const active = (segment: string) => path === `/${segment}` || path.startsWith(`/${segment}/`);

const items: { key: string; href: string; label: string; current: boolean; star?: boolean }[] = [
  { key: 'home', href: home, label: t.navHome, current: path === '/' },
  ...NAV_CATEGORIES.map((c) => ({ key: c, href: localePath(locale, `/${c}`), label: categoryLabel(c, locale), current: active(c) })),
  { key: 'malaysia', href: localePath(locale, '/malaysia'), label: t.malaysia, current: path === '/malaysia' },
  { key: 'favourites', href: localePath(locale, '/favourites'), label: t.favorites, current: path === '/favourites', star: true },
  { key: 'feedback', href: localePath(locale, '/feedback'), label: t.navFeedback, current: path === '/feedback' },
];
---

{/* Solid, not frosted. A backdrop-filter on a bar that also carries a
    view-transition-name is what smeared the whole header for two or three
    frames after every page change (screen recording, 2026-09-25). A solid bar
    costs nothing to scroll and does not repaint behind itself. */}
<header class="vt-nav sticky top-0 z-40 border-b border-border bg-bg">
  <nav class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 app-shell:h-13 sm:px-6" aria-label={t.mainNav}>
    <a href={home} aria-label={t.home} class="flex h-11 min-w-11 shrink-0 items-center gap-2 text-base font-bold tracking-tight">
      <Logo />
      {/* In the app shell the category row lives in the tab bar at the bottom,
          so the header has room for the name again, as an app's title bar
          does. With the header row it shows only for a mouse at 1280px and
          up: anywhere narrower, or with touch padding on every link, the
          eight links need its room. The mark still links home. */}
      <span class="hidden app-shell:inline xl:pointer-fine:inline"><span class="text-accent">Nhako</span>Tools</span>
    </a>

    {/*
      A scroll container, not a menu: no open state, no focus trap, no
      JavaScript. Below 768px this row used to be `hidden md:flex`, which left
      a phone with no category navigation at all, only the search button.
      Scrolling is the whole adaptation.

      It stays `flex-1 min-w-0` at every width. It used to become `md:flex-none`
      from 768px, which stopped it shrinking, and on a touch screen, where
      `pointer-coarse` pads every item, the row then outgrew the bar between
      768px and about 850px and pushed search, language and theme off the right
      edge, so every page scrolled sideways on an iPad held upright. Where
      there is room the two look identical, because the items are left aligned
      and `ml-auto` still holds the controls to the right.
    */}
    {/* In the app shell (phones, upright touch tablets) the tab bar carries these instead. */}
    <ul data-nav-list data-ind-list="header" class="ind-list relative isolate -mx-1 flex min-w-0 app-shell:hidden flex-1 items-stretch gap-0.5 self-stretch overflow-x-auto px-1 [scrollbar-width:none] pointer-coarse:gap-1 [&::-webkit-scrollbar]:hidden">
      {/*
        Where you are, said three ways so no one of them has to carry it: the
        label turns accent, a tinted pill sits behind it, and a bar sits on
        the header's bottom edge like a tab. aria-current says it to a screen
        reader. The pill and bar are one element that slides from the last
        page's item to this one's (window.nhakoIndicator in BaseLayout). It is
        drawn inside the list because the list scrolls.
      */}
      <li data-ind role="none" aria-hidden="true" class="ind">
        <span class="ind-pill rounded-md bg-accent-subtle"></span>
        <span class="ind-bar"></span>
      </li>
      {items.map((item) => (
        <li class="flex shrink-0 items-center">
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            data-ind-key={item.key}
            class:list={[
              'nav-link flex scroll-mx-4 items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm font-semibold transition-colors duration-[120ms]',
              'pointer-coarse:min-h-11 pointer-coarse:px-3',
              item.current ? 'text-accent' : 'text-muted hover:bg-sunken hover:text-text',
            ]}
          >
            {item.star && (
              <svg class="size-3.5" viewBox="0 0 24 24" fill={item.current ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
              </svg>
            )}
            {item.label}
            {item.star && (
              <span data-fav-count hidden class="min-w-4 rounded-full bg-accent px-1 text-center text-2xs leading-4 font-semibold text-accent-on tabular-nums"></span>
            )}
          </a>
        </li>
      ))}
    </ul>

    <div class="ml-auto flex shrink-0 items-center gap-2">
      <CommandPalette locale={locale} />
      {alternates && (
        <a
          href={localePath(other, path)}
          hreflang={other}
          lang={other}
          aria-label={`${t.switchLanguageShort}, ${t.switchLanguageLabel}`}
          class="grid h-8 place-items-center rounded border border-border px-2 font-mono app-shell:hidden text-2xs font-semibold text-muted transition-colors duration-[120ms] hover:border-border-strong hover:text-text pointer-coarse:h-11 pointer-coarse:px-3"
        >
          {t.switchLanguageShort}
        </a>
      )}
      {/* Coffee, language and theme move into the More sheet on a phone,
          leaving the title bar its name and the one action people reach for. */}
      <span class="contents app-shell:hidden"><CoffeeButton locale={locale} variant="icon" /></span>
      <span class="contents app-shell:hidden"><ThemeToggle locale={locale} /></span>
    </div>
  </nav>
</header>

<script is:inline>
  // On a phone the row scrolls, and the current page can sit off the right
  // edge. Bring it into view without scrolling the page itself.
  (() => {
    const list = document.querySelector('[data-nav-list]');
    const current = list?.querySelector('[aria-current="page"]');
    if (list && current && list.scrollWidth > list.clientWidth) {
      list.scrollLeft = Math.max(0, current.offsetLeft - (list.clientWidth - current.offsetWidth) / 2);
    }
  })();
  // After the scroll above, so the pill is measured where the link now sits.
  window.nhakoIndicator?.(document.querySelector('.vt-nav'));
</script>
