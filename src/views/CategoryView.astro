---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolTile, { type Preset } from '../components/astro/ToolTile.astro';
import { TOOLS, toolsIn } from '../tools/registry';
import { groupsIn, hasGroups } from '../tools/groups';
import { toolId, type Category, type ToolMeta } from '../tools/types';
import { categoryLabel, categoryModifier, groupLabel, localizeTool, localizeVariant, localePath, ui, type Locale } from '../i18n';

interface Props { category: Category; locale: Locale }
const { category, locale } = Astro.props;
const t = ui(locale);
const label = categoryLabel(category, locale);
/* The <h1> and the breadcrumb want the display label ("Calculators"); the
   <title>, the meta description and the schema name put it in front of the
   word "tool", where that plural does not work. */
const modifier = categoryModifier(category, locale);
const own = toolsIn(category);

const path = `/${category}`;
const href = (p: string) => localePath(locale, p);

/** Preset chips for a tool, or none. Localised here for the same reason the
 *  tool is: ToolTile renders words, it does not choose them. */
const presetsFor = (tool: ToolMeta): Preset[] =>
  (tool.variants ?? []).map((v) => {
    const localized = localizeVariant(tool, v, locale);
    return { href: href(`/${toolId(tool)}/${v.slug}`), short: v.short, name: localized.name };
  });

/**
 * Rows for one group: the category's own tools, then anything cross-listed in.
 * A cross-listed tool renders identically, because the data model is not the
 * reader's problem.
 */
const rowsIn = (groupId: string): ToolMeta[] => [
  ...own.filter((x) => x.group === groupId),
  ...TOOLS.filter((x) => (x.alsoIn ?? []).some((r) => r.category === category && r.group === groupId)),
];

// Flat below the threshold: a heading over two rows costs a glance and returns
// nothing. groupsIn() is empty for those categories, which is the signal.
const grouped = hasGroups(category);
const groups = groupsIn(category);
/** Every row on the page, in job order, each tagged with the job it is filed
 *  under here, which is what the filter chips match on. */
const rows: { tool: ToolMeta; group?: string }[] = grouped
  ? groups.flatMap((g) => rowsIn(g.id).map((tool) => ({ tool, group: g.id })))
  : own.map((tool) => ({ tool }));

// The count labels the category, not the page. Image owns 11 tools and shows
// 14 rows, because three are cross-listed in from PDF and Developer. Counting
// rows would print 14 here while the homepage printed 11, and the five
// category pages would sum to 46 against a real catalogue of 43.
const count = own.length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t.categoryHeading(modifier),
  url: new URL(href(path), 'https://tools.nhako.com').href,
  description: t.categoryIntro[category],
  isPartOf: { '@type': 'WebSite', name: 'Nhako Tools', url: 'https://tools.nhako.com' },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.breadcrumbTools, item: new URL(href('/'), 'https://tools.nhako.com').href },
      { '@type': 'ListItem', position: 2, name: label },
    ],
  },
};
import BackLink from '../components/astro/BackLink.astro';
---

<BaseLayout
  title={t.categoryHeading(modifier)}
  documentTitle={t.categoryTitle(modifier)}
  description={t.categoryDescription(modifier, own.length)}
  path={path}
  locale={locale}
  category={category}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="pt-1 sm:pt-6 sm:pointer-fine:hidden"><BackLink href={href('/')} label={t.breadcrumbTools} locale={locale} /></div>
    <nav aria-label={t.breadcrumb} class="pt-8 text-2xs text-muted max-sm:hidden pointer-coarse:hidden">
      <a href={href('/')} class="transition-colors hover:text-accent pointer-coarse:inline-flex pointer-coarse:min-h-11 pointer-coarse:items-center">{t.breadcrumbTools}</a>
      <span aria-hidden="true"> / </span>
      <span class="text-text">{label}</span>
    </nav>

    <header class="mb-5 mt-1 sm:mb-8 sm:mt-4">
      <div class="flex items-baseline gap-2.5">
        <h1 class="text-2xl font-bold tracking-tight">{label}</h1>
        <span data-numeric class="ml-auto font-mono text-2xs text-muted">{count}</span>
      </div>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted sm:mt-3">{t.categoryIntro[category]}</p>
    </header>

    {/*
      Filter chips, not headings. Each job group used to be a heading over its
      own block of tools, plus a row of jump links to reach them. The headings
      are gone (Kim, 2026-09-25: they cost a phone a screen and a half of
      scrolling to repeat what the tool names say), and the chips now narrow
      the one list in place instead of scrolling to a heading. On a phone the
      row scrolls sideways rather than wrapping into three ragged lines.

      Buttons that only work with JavaScript, so they arrive `hidden` and the
      script below shows them. Without it the full list is simply there.
    */}
    {grouped && (
      <div data-filter hidden role="group" aria-label={t.filterBy} class="chip-scroller -mt-1 mb-5 flex gap-2 sm:mb-8 sm:flex-wrap">
        {[{ id: '', label: t.filterAll, n: undefined }, ...groups.map((g) => ({ id: g.id, label: groupLabel(category, g.id, locale), n: rowsIn(g.id).length }))].map((chip) => (
          <button
            type="button"
            data-filter-group={chip.id}
            aria-pressed={chip.id === '' ? 'true' : 'false'}
            class="inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-surface px-3.5 py-1.5 text-xs font-medium text-text transition-colors duration-[120ms] hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:bg-accent-subtle aria-pressed:text-accent pointer-coarse:min-h-11 pointer-coarse:text-sm"
          >
            {chip.label}
            {/* No count on All: it would say 14 on /image, where the header
                rightly says 11 (three rows are cross-listed in). */}
            {chip.n !== undefined && <span data-numeric class="text-muted">{chip.n}</span>}
          </button>
        ))}
      </div>
    )}

    <div class="tool-list mb-9 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {rows.map(({ tool, group }) => (
        <ToolTile
          tool={localizeTool(tool, locale)}
          href={href(`/${toolId(tool)}`)}
          presets={presetsFor(tool)}
          group={group}
        />
      ))}
    </div>

    <p class="mb-16 text-xs text-muted">
      <a href={href('/')} class="transition-colors hover:text-accent pointer-coarse:inline-flex pointer-coarse:min-h-11 pointer-coarse:items-center">{t.allTools(TOOLS.length)}</a>
    </p>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const bar = document.querySelector('[data-filter]');
    if (!bar) return;
    const chips = [...bar.querySelectorAll('[data-filter-group]')];
    const cards = [...document.querySelectorAll('main [data-tool-card]')];
    const apply = (id) => {
      for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.filterGroup === id));
      for (const card of cards) card.hidden = id !== '' && card.dataset.groupId !== id;
    };
    bar.addEventListener('click', (event) => {
      const chip = event.target instanceof Element ? event.target.closest('[data-filter-group]') : null;
      if (!chip) return;
      apply(chip.dataset.filterGroup);
      // Keep the address shareable, and the old #group-… links working.
      history.replaceState(null, '', chip.dataset.filterGroup ? `#group-${chip.dataset.filterGroup}` : location.pathname);
    });
    bar.hidden = false;
    const fromHash = location.hash.startsWith('#group-') ? location.hash.slice(7) : '';
    if (fromHash && chips.some((c) => c.dataset.filterGroup === fromHash)) {
      apply(fromHash);
      bar.querySelector('[aria-pressed="true"]')?.scrollIntoView({ block: 'nearest', inline: 'center' });
    }
  })();
</script>
