---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolTile from '../components/astro/ToolTile.astro';
import ToolIcon from '../components/astro/ToolIcon.astro';
import { TOOLS, toolsIn } from '../tools/registry';
import { popularLinks } from '../tools/popular';
import { CATEGORIES, toolId } from '../tools/types';
import { groupsIn } from '../tools/groups';
import { LANG, categoryLabel, localizeTool, localePath, ui, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui(locale);
const home = new URL(localePath(locale, '/'), 'https://tools.nhako.com').href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Nhako Tools',
  url: home,
  inLanguage: LANG[locale],
  description: t.siteDescription(TOOLS.length),
  potentialAction: {
    '@type': 'SearchAction',
    target: `${home}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title="Nhako Tools"
  documentTitle={t.homeTitle}
  description={t.homeDescription(TOOLS.length)}
  path="/"
  locale={locale}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    {/*
      A directory hero: the search IS the call to action, and the jobs students
      come for most sit one tap under it. It used to share the row with a typed
      terminal readout; with that gone (2026-09-25) the hero is one column, and
      the space goes to getting someone to their tool, not to decoration.
    */}
    {/* On a phone the hero is an app's large title: the promise in two
        lines and the search right under it, so the first screen reaches a
        tool rather than a paragraph. The paragraph returns from 640px. */}
    <section class="pt-5 pb-3 sm:pt-14 sm:pb-6">
      <h1 class="max-w-3xl text-balance text-[1.75rem] font-bold leading-[1.12] tracking-tight sm:text-4xl">
        {/* The wedge leads and carries full strength. The mechanism, which is
            what the tool count describes, supports it. The brief is explicit
            that privacy-as-mechanism is never the headline, and for a year
            this said it the other way round. */}
        {t.heroSubtitle}
        <span class="block text-muted">{t.heroTitle(TOOLS.length)}</span>
      </h1>
      <p class="mt-4 max-w-2xl text-base text-muted max-sm:hidden">{t.heroBody}</p>

      <div class="mt-5 max-w-2xl sm:mt-7">
        <label for="tool-search" class="sr-only">{t.searchAll}</label>
        <div class="relative">
          <svg class="pointer-events-none absolute left-4 top-1/2 size-4 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" stroke-linecap="round" />
          </svg>
          <input
            id="tool-search"
            type="search"
            autocomplete="off"
            placeholder={t.searchPlaceholder(TOOLS.length)}
            class="h-12 w-full rounded-lg border border-border-strong bg-surface pl-11 pr-4 text-base outline-none transition-colors placeholder:text-muted hover:border-accent focus:border-accent"
          />
        </div>
        <p id="search-status" role="status" class="mt-2 h-4 text-2xs text-muted max-sm:mt-1.5" data-template={t.searchCount(1111, 2222)}></p>
      </div>
    </section>

    {/*
      The jobs students arrive for most, as real cards rather than a row of
      grey pills. Each carries its tool's mark in the category hue, so the
      eye can find "the PDF ones" without reading, and a one-line blurb from a
      tablet up. Seven tools plus a way into the full list make an even 4 x 2
      on a desktop and 2 x 4 on a phone, so no row ends ragged.
    */}
    <section aria-labelledby="popular-heading" class="pb-6" data-popular>
      <div class="mb-3 sm:mb-4">
        <h2 id="popular-heading" class="text-base font-bold tracking-tight">{t.popular}</h2>
        <p class="mt-0.5 text-sm text-muted max-sm:hidden">{t.popularHint}</p>
      </div>
      <ul class="grid grid-cols-2 gap-2.5 sm:gap-3 lg:grid-cols-4">
        {popularLinks(locale).map((p) => (
          <li class="flex">
            <a
              href={p.href}
              class="popular-card group/pop relative flex w-full items-start gap-3 rounded-xl border border-border bg-surface p-3 shadow-[inset_0_1px_0_var(--edge)] transition-[border-color,transform,background-color] duration-150 hover:-translate-y-0.5 hover:border-accent hover:bg-bg focus-visible:border-accent active:bg-sunken max-sm:items-center max-sm:gap-2.5 max-sm:p-2.5 sm:p-3.5"
            >
              <span class="grid size-9 shrink-0 place-items-center rounded-lg border border-border bg-bg transition-colors duration-150 group-hover/pop:border-accent/30 group-hover/pop:bg-accent-subtle sm:size-11">
                <ToolIcon tool={p.tool} />
              </span>
              <span class="flex min-w-0 flex-1 flex-col">
                <span class="pr-4 text-sm font-semibold leading-snug transition-colors group-hover/pop:text-accent">{p.name}</span>
                <span class="mt-0.5 text-xs leading-snug text-muted line-clamp-2 max-sm:hidden">{p.blurb}</span>
              </span>
              <svg class="absolute right-3 top-3.5 hidden size-4 -translate-x-1 text-accent opacity-0 transition-[opacity,transform] duration-150 group-hover/pop:translate-x-0 group-hover/pop:opacity-100 sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </li>
        ))}
        <li class="flex">
          <a
            href={`#${CATEGORIES[0]}`}
            class="group/pop flex min-h-[3.75rem] w-full items-center justify-center gap-2 rounded-xl border border-dashed border-border-strong p-3 text-sm font-semibold text-muted transition-colors duration-150 hover:border-accent hover:bg-accent-subtle hover:text-accent active:bg-sunken sm:p-3.5"
          >
            {t.allTools(TOOLS.length)}
            <svg class="size-4 transition-transform duration-150 group-hover/pop:translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 5v14M6 13l6 6 6-6" />
            </svg>
          </a>
        </li>
      </ul>
    </section>

    {/*
      Every tool is here exactly once. Cross-listings (a tool shown in a second
      category) are a category-page affordance only: on the catalogue itself a
      row appearing twice would make the count disagree with the heading and
      read as a bug.

      One heading per category and no more. Each category used to carry a
      second tier of job headings ("Organise pages", "Convert to and from
      PDF"...), fifteen of them, which cost a phone about 600px of scrolling
      to say what the tool names beside them already say (Kim, 2026-09-25).
      The tools keep their job order, so "Merge" still sits beside "Split",
      and a category page can still filter by job.
    */}
    {CATEGORIES.map((category) => {
      const groups = groupsIn(category);
      const tools = groups.length > 0
        ? groups.flatMap((group) => toolsIn(category).filter((tool) => tool.group === group.id))
        : toolsIn(category);
      return (
        <section id={category} class="scroll-mt-20 pb-4 pt-6 sm:pt-8" data-category-section={category}>
          <div class="mb-2.5 flex items-baseline gap-2.5 px-1 sm:mb-4 sm:px-0">
            <h2 class="text-2xs font-semibold uppercase tracking-[0.14em] text-muted">
              <a href={localePath(locale, `/${category}`)} class="transition-colors hover:text-accent pointer-coarse:inline-flex pointer-coarse:min-h-11 pointer-coarse:min-w-11 pointer-coarse:items-center pointer-coarse:-my-3.5">
                {categoryLabel(category, locale)}
              </a>
            </h2>
            <span data-numeric class="ml-auto font-mono text-2xs text-muted">{toolsIn(category).length}</span>
          </div>

          <div class="tool-list grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {tools.map((tool) => (
              <ToolTile tool={localizeTool(tool, locale)} href={localePath(locale, `/${toolId(tool)}`)} />
            ))}
          </div>
        </section>
      );
    })}

    {/*
      `data-search-empty`, not `data-empty`: the command palette's list already
      carries `data-empty` as the attribute holding its own message, and it
      sits in the nav, ahead of this element in the document. A bare
      `[data-empty]` selector therefore matched the palette and this message
      never once appeared, while the filter quietly toggled `hidden` on the
      palette's list instead.
    */}
    <p data-search-empty hidden class="py-16 text-center text-sm text-muted">{t.searchEmpty}</p>
  </div>
</BaseLayout>

<script>
  // Progressive enhancement: the full grid is in the HTML and works with no JS.
  // This only filters what is already there.
  const input = document.querySelector<HTMLInputElement>('#tool-search');
  const status = document.querySelector<HTMLElement>('#search-status');
  const empty = document.querySelector<HTMLElement>('[data-search-empty]');
  const popular = document.querySelector<HTMLElement>('[data-popular]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-tool-card]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-category-section]')];
  const anyVisible = (el: HTMLElement) =>
    [...el.querySelectorAll<HTMLElement>('[data-tool-card]')].some((c) => !c.hidden);

  function filter(raw: string) {
    const query = raw.trim().toLowerCase();
    let visible = 0;

    for (const card of cards) {
      const haystack = `${card.dataset.name ?? ''} ${card.dataset.keywords ?? ''} ${card.dataset.category ?? ''} ${card.textContent?.toLowerCase() ?? ''}`;
      const match = query === '' || query.split(/\s+/).every((term) => haystack.includes(term));
      card.hidden = !match;
      if (match) visible++;
    }

    // A category heading left standing over nothing is a dead end.
    for (const section of sections) section.hidden = !anyVisible(section);

    if (empty) empty.hidden = visible > 0;
    // While a search is live the shortcuts are noise between the box and
    // its results; they come back when the box is cleared.
    if (popular) popular.hidden = query !== '';
    // The sentence comes from the server in the page's language, with
    // placeholder numbers to swap in.
    const template = status?.dataset.template ?? '1111 / 2222';
    if (status) status.textContent = query === '' ? '' : template.replace('1111', String(visible)).replace('2222', String(cards.length));
  }

  input?.addEventListener('input', () => filter(input.value));

  // Support /?q=… so the site's own SearchAction target actually works.
  const initial = new URLSearchParams(location.search).get('q');
  if (initial && input) {
    input.value = initial;
    filter(initial);
  }
</script>
