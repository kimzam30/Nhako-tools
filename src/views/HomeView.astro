---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolTile from '../components/astro/ToolTile.astro';
import HeroReadout from '../components/astro/HeroReadout.astro';
import { TOOLS, toolsIn } from '../tools/registry';
import { CATEGORIES, toolId } from '../tools/types';
import { groupsIn, hasGroups } from '../tools/groups';
import { LANG, categoryLabel, groupLabel, localizeTool, localePath, ui, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui(locale);
const home = new URL(localePath(locale, '/'), 'https://tools.nhako.com').href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Nhako Tools',
  url: home,
  inLanguage: LANG[locale],
  description: t.siteDescription(TOOLS.length),
  potentialAction: {
    '@type': 'SearchAction',
    target: `${home}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title="Nhako Tools"
  documentTitle={t.homeTitle}
  description={t.homeDescription(TOOLS.length)}
  path="/"
  locale={locale}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <section class="grid items-center gap-10 pt-12 pb-10 sm:pt-16 sm:pb-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-14">
      <div>
      <h1 class="max-w-3xl text-3xl font-bold leading-[1.12] tracking-tight sm:text-4xl">
        {/* The wedge leads and carries full strength. The mechanism, which is
            what the tool count describes, supports it. The brief is explicit
            that privacy-as-mechanism is never the headline, and for a year
            this said it the other way round. */}
        {t.heroSubtitle}
        <span class="block text-muted">{t.heroTitle(TOOLS.length)}</span>
      </h1>
      <p class="mt-4 max-w-xl text-base text-muted">{t.heroBody}</p>

      <div class="mt-7 max-w-md">
        <label for="tool-search" class="sr-only">{t.searchAll}</label>
        <input
          id="tool-search"
          type="search"
          autocomplete="off"
          placeholder={t.searchPlaceholder(TOOLS.length)}
          class="w-full rounded-md border border-border bg-surface px-3.5 py-2.5 text-sm outline-none transition-colors placeholder:text-muted hover:border-border-strong focus:border-accent"
        />
        <p id="search-status" role="status" class="mt-2 h-4 text-2xs text-muted" data-template={t.searchCount(1111, 2222)}></p>
      </div>
      </div>

      <HeroReadout locale={locale} />
    </section>

    {/*
      Every tool is here exactly once. Cross-listings (a tool shown in a second
      category) are a category-page affordance only: on the catalogue itself a
      row appearing twice would make the count disagree with the heading and
      read as a bug.
    */}
    {CATEGORIES.map((category) => (
      <section id={category} class="scroll-mt-20 pb-8 pt-10" data-category-section={category}>
        <div class="mb-4 flex items-baseline gap-2.5">
          <h2 class="text-2xs font-semibold uppercase tracking-[0.14em] text-muted">
            <a href={localePath(locale, `/${category}`)} class="transition-colors hover:text-accent">
              {categoryLabel(category, locale)}
            </a>
          </h2>
          {/* The hue identifies the category and nothing more. It used to be a
              segment at the head of a full-width rule; with the rule gone it is
              drawn as a dot, so it reads as a marker rather than as the stub of
              a line that is no longer there. It stays redundant with the
              heading beside it by design: colour is never the only encoding. */}
          <span class="size-1.5 shrink-0 rounded-full" style={`background:var(--cat-${category})`} aria-hidden="true"></span>
          <span data-numeric class="ml-auto font-mono text-2xs text-muted">{toolsIn(category).length}</span>
        </div>

        {hasGroups(category)
          ? groupsIn(category).map((group) => (
              /* Space above a heading must beat space below it, or the label
                 reads as belonging to the group it follows. Measured at 768px
                 before this fix: 14px above, 5px below, the wrong way round.
                 The rule under the heading binds it downwards as well. */
              <section data-group class="mt-6 first:mt-0">
                <h3 class="mb-2 text-2xs font-medium tracking-wide text-muted">{groupLabel(category, group.id, locale)}</h3>
                <div class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                  {toolsIn(category).filter((tool) => tool.group === group.id).map((tool) => (
                    <ToolTile tool={localizeTool(tool, locale)} href={localePath(locale, `/${toolId(tool)}`)} />
                  ))}
                </div>
              </section>
            ))
          : (
            <div class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {toolsIn(category).map((tool) => (
                <ToolTile tool={localizeTool(tool, locale)} href={localePath(locale, `/${toolId(tool)}`)} />
              ))}
            </div>
          )}
      </section>
    ))}

    {/*
      `data-search-empty`, not `data-empty`: the command palette's list already
      carries `data-empty` as the attribute holding its own message, and it
      sits in the nav, ahead of this element in the document. A bare
      `[data-empty]` selector therefore matched the palette and this message
      never once appeared, while the filter quietly toggled `hidden` on the
      palette's list instead.
    */}
    <p data-search-empty hidden class="py-16 text-center text-sm text-muted">{t.searchEmpty}</p>
  </div>
</BaseLayout>

<script>
  // Progressive enhancement: the full grid is in the HTML and works with no JS.
  // This only filters what is already there.
  const input = document.querySelector<HTMLInputElement>('#tool-search');
  const status = document.querySelector<HTMLElement>('#search-status');
  const empty = document.querySelector<HTMLElement>('[data-search-empty]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-tool-card]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-category-section]')];
  const anyVisible = (el: HTMLElement) =>
    [...el.querySelectorAll<HTMLElement>('[data-tool-card]')].some((c) => !c.hidden);

  function filter(raw: string) {
    const query = raw.trim().toLowerCase();
    let visible = 0;

    for (const card of cards) {
      const haystack = `${card.dataset.name ?? ''} ${card.dataset.keywords ?? ''} ${card.dataset.category ?? ''} ${card.textContent?.toLowerCase() ?? ''}`;
      const match = query === '' || query.split(/\s+/).every((term) => haystack.includes(term));
      card.hidden = !match;
      if (match) visible++;
    }

    // Groups before sections: a category is empty only once every group in it
    // is. A job heading left standing over nothing is a dead end for whoever
    // reads it.
    for (const group of groups) group.hidden = !anyVisible(group);
    for (const section of sections) section.hidden = !anyVisible(section);

    if (empty) empty.hidden = visible > 0;
    // The sentence comes from the server in the page's language, with
    // placeholder numbers to swap in.
    const template = status?.dataset.template ?? '1111 / 2222';
    if (status) status.textContent = query === '' ? '' : template.replace('1111', String(visible)).replace('2222', String(cards.length));
  }

  input?.addEventListener('input', () => filter(input.value));

  // Support /?q=… so the site's own SearchAction target actually works.
  const initial = new URLSearchParams(location.search).get('q');
  if (initial && input) {
    input.value = initial;
    filter(initial);
  }
</script>
