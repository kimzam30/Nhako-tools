---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOOLS } from '../tools/registry';
import { ui } from '../i18n';

// One 404 serves both languages (static hosts have a single not-found page),
// so it says everything twice rather than guessing.
const en = ui('en');
const ms = ui('ms');
---
<BaseLayout title="Page not found" description="That page does not exist. Browse the full set of Nhako tools instead." path="/404" alternates={false}>
  <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <p data-numeric class="text-sm text-muted">404</p>
    <h1 class="mt-3 text-2xl font-bold tracking-tight">{en.notFoundTitle}</h1>
    <p class="mx-auto mt-3 max-w-md text-sm text-muted">{en.notFoundBody(TOOLS.length)}</p>
    <p lang="ms" class="mx-auto mt-3 max-w-md text-sm text-muted">{ms.notFoundTitle} {ms.notFoundBody(TOOLS.length)}</p>
    <div class="mt-7 flex justify-center gap-3">
      <a href="/" class="inline-block rounded bg-accent px-4 py-2 text-sm font-medium text-accent-on transition-colors hover:bg-accent-hover">
        {en.browseAll}
      </a>
      <a href="/ms" lang="ms" class="inline-block rounded border border-border px-4 py-2 text-sm font-medium transition-colors hover:border-accent hover:text-accent">
        {ms.browseAll}
      </a>
    </div>
    <p class="mt-8 text-xs text-muted">
      <a href="/feedback?kind=bug&from=/404" class="underline decoration-border underline-offset-2 transition-colors hover:text-accent">Tell us about a broken link</a>
      <span aria-hidden="true"> / </span>
      <a href="/ms/feedback?kind=bug&from=/404" lang="ms" class="underline decoration-border underline-offset-2 transition-colors hover:text-accent">Laporkan pautan rosak</a>
    </p>
  </div>
</BaseLayout>
