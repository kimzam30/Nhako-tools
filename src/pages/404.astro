---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOOLS } from '../tools/registry';
---
<BaseLayout title="Page not found" description="That page does not exist. Browse the full set of Nhako tools instead." path="/404">
  <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <p data-numeric class="text-sm text-muted">404</p>
    <h1 class="mt-3 text-2xl font-bold tracking-tight">That page doesn't exist.</h1>
    <p class="mx-auto mt-3 max-w-md text-sm text-muted">
      It may have moved during the rebuild. All {TOOLS.length} tools are listed on the
      home page, and ⌘K searches them from anywhere.
    </p>
    <a href="/" class="mt-7 inline-block rounded bg-accent px-4 py-2 text-sm font-medium text-accent-on transition-colors hover:bg-accent-hover">
      Browse all tools
    </a>
  </div>
</BaseLayout>
